# --- Build output ---
/watcherbridge
/bin/
/dist/
*.exe
*.dll
*.so
*.dylib

# --- Go tooling ---
*.test
*.out
coverage.*
go.work
go.work.sum

# --- Secrets and local config (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
config.local.*

# --- Runtime data: may contain real network information ---
# Local event log, pseudonym map, and scan reports stay on your machine.
# Committed test fixtures belong in testdata/ and must be synthetic.
/data/
/reports/
/scan-reports/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
pseudonyms.*

# --- UI toolchain (project-local, never commit) ---
ui/node_modules/
ui/.smoke-tmp/

# --- E2E harness output (rebuilt/preserved per run, never committed) ---
.e2e-bin/
.e2e-last-failure/
.e2e-failures/
.e2e-pending.txt
e2e/results/

# --- Editors and IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS files ---
.DS_Store
Thumbs.db
.innerdoc
AGENTS.md
