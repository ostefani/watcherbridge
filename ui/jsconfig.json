{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$components/*": ["src/components/*"],
      "$containers/*": ["src/containers/*"],
      "$api/*": ["src/api/*"],
      "$styles/*": ["src/styles/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.js", "eslint.config.js"]
}
